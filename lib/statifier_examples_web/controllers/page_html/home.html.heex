<Layouts.flash_group flash={@flash} />
<main class="mx-auto max-w-2xl px-4 py-16">
  <h1 class="text-2xl font-semibold">Documents</h1>
  <p class="mt-4 text-sm opacity-80">
    The example block documents this app hosts. Each one opens in the editor
    host page, which reads the document and the theme off the URL.
  </p>
  <ul class="mt-8 space-y-4">
    <li :for={fixture <- @fixtures} class="border rounded-lg p-4">
      <a class="font-medium underline" href={~p"/editor?#{[doc: fixture.key]}"}>
        {fixture.name}
      </a>
      <p class="mt-1 text-sm opacity-70">
        revision {fixture.document.revision} &middot; {fixture.document.id}
      </p>
    </li>
  </ul>
</main>
